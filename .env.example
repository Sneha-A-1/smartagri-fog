# SmartAgri-Fog settings. Copy to .env (setup.ps1 does this) and edit. Every line is optional.

# Where the database and local working files live (relative to the project folder or absolute).
SMARTAGRI_DATA_DIR=data/local

# Where job and experiment results are written. Point this at your results drive, for example:
# SMARTAGRI_RESULTS_DIR=D:\SmartAgriData\results

# Parallel worker processes for jobs. 2 suits an 8 GB laptop; raise it with more RAM.
SMARTAGRI_JOB_WORKERS=2

# Local mode: single user on your own computer, no sign-in. Set to false for a shared deployment.
SMARTAGRI_LOCAL_MODE=true

# Required when SMARTAGRI_LOCAL_MODE=false: a long random secret used to sign login tokens.
# SMARTAGRI_SECRET_KEY=
